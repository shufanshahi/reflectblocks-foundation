# Google Sign-In
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ReflectBlocks local storage/session
REFLECTBLOCKS_DATA_DIR=.data
REFLECTBLOCKS_SESSION_SECRET=
COOKIE_SECURE=false

# Gemini API — server-side only
GEMINI_API_KEY=

# Recommended split for ReflectBlocks:
# - Lite model for fast optional next-question suggestions
# - stronger Flash model for nuanced journal organization
GEMINI_SUGGESTION_MODEL=gemini-3.1-flash-lite
GEMINI_JOURNAL_MODEL=gemini-3.1-flash-lite

# Backward-compatible single-model override. If set and the two variables above
# are absent, both AI features use this model.
GEMINI_MODEL=
